{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOTH",
  "version": "0.5.0",
  "identifier": "app.moth.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MOTH",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: https://*.googleusercontent.com http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MOTH",
    "shortDescription": "A self-evolving second brain for Claude",
    "longDescription": "MOTH gives Claude a private, persistent memory through MCP: it retrieves context before tasks, learns after them and keeps its knowledge organised.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/moth-core"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OTAxQkREQUJGMEU0NEMKUldSTTVQQ3IzUnVRS1E3YS9pM0g2OFdwTSsrV2dLM0thd2NMTEEyRXVCNkNGOXROUkQ4RHdQVmMK",
      "endpoints": [
        "https://github.com/lk5t/moth/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
