{
  "name": "@moth/core",
  "version": "0.5.0",
  "private": true,
  "description": "MOTH memory engine, MCP server and local API (runs as the desktop app's sidecar)",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.ts",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node scripts/build-sea.mjs",
    "serve": "node --experimental-transform-types --disable-warning=ExperimentalWarning src/index.ts serve --static ../app/dist",
    "mcp": "node --experimental-transform-types --disable-warning=ExperimentalWarning src/index.ts mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.8.3"
  }
}
